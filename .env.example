# ── The one Flespi key ──────────────────────────────────────────────────────
#
# Server-side ONLY. Never prefix it with VITE_: Vite would inline it into the
# public bundle. The browser never talks to Flespi directly any more; it calls a
# proxy that adds this key:
#   - `vite dev` (mock mode): the dev-server proxy in vite.config.js reads it here;
#   - Netlify: the flespi-proxy function reads FLESPI_TOKEN from the site's env
#     vars (set it as a SECRET, Functions scope). Read-only: GET gw/devices only;
#   - real mode: the backend (server/.env FLESPI_TOKEN) proxies /api/flespi/proxy.
# Use the same key everywhere, so the Flespi account has exactly one.
FLESPI_TOKEN=your-flespi-token  # server-side only; never prefix with VITE_

# ── The mode switch (src/data/mode.js) ──────────────────────────────────────
#
# SET   → real mode: real login against the FleetmaX API, and every Settings page
#         plus the Live Map's visible fleet read through it.
# UNSET → mock mode: today's behaviour exactly — the in-memory Settings store in
#         src/pages/settings/mockData.js, backed by localStorage.
#
# Deliberately left UNSET here and on Netlify: the deployed demo cannot reach a
# backend on localhost, so leaving it out is what keeps that build working. Set it
# in your local .env to develop against the real server.
#
# No trailing slash. The backend defaults to port 4000 (see server/.env.example).
# VITE_API_URL=http://localhost:4000

# Server-side only (Netlify function). No VITE_ prefix by design.
GEMINI_API_KEY=
