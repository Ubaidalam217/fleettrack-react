# ── Flespi token for the browser ────────────────────────────────────────────
#
# MUST be a LIMITED ACL token, never a Master token.
#
# Vite inlines any VITE_* variable into the public bundle at BUILD time, so
# whatever goes here is readable by anyone who loads the site. A Master token here
# would hand the whole Flespi account — including the ability to mint more tokens
# and delete devices — to every visitor.
#
# Create one in the Flespi panel (Tokens > ACL) or via the API with a Master token:
#
#   POST https://flespi.io/platform/tokens
#   [{"info":"FleetmaX demo bundle","ttl":31536000,
#     "access":{"type":2,"acl":[{"uri":"gw/devices","methods":["GET","PUT"]}]}}]
#
#   access.type 2 = ACL (1 = Master). Omitting `ids` covers every device in the
#   account, which is what the demo shows. MQTT access follows the REST ACL
#   automatically — no separate mqtt entry is needed, and ["GET"] still permits
#   MQTT subscribe (PUT only governs REST writes).
#
#   ["GET"] is what the deployed demo uses, and it is the right default: this
#   token is public, and GET-only means nobody reading the bundle can write to a
#   live fleet. The cost is that the vehicle Console's Save and the Poll action
#   return 403 in mock mode. Add "PUT" only if a writable demo is genuinely wanted.
VITE_FLESPI_TOKEN=your_readonly_acl_token_here

# ── The mode switch (src/data/mode.js) ──────────────────────────────────────
#
# SET   → real mode: real login against the FleetmaX API, and every Settings page
#         plus the Live Map's visible fleet read through it.
# UNSET → mock mode: today's behaviour exactly — the in-memory Settings store in
#         src/pages/settings/mockData.js, backed by localStorage.
#
# Deliberately left UNSET here and on Netlify: the deployed demo cannot reach a
# backend on localhost, so leaving it out is what keeps that build working. Set it
# in your local .env to develop against the real server.
#
# No trailing slash. The backend defaults to port 4000 (see server/.env.example).
# VITE_API_URL=http://localhost:4000

# Server-side only (Netlify function). No VITE_ prefix by design.
GEMINI_API_KEY=
