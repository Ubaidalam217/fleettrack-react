// FleetmaX tracking backend — data model.
//
// Mirrors the Settings module the frontend already ships against its in-memory
// mock (src/pages/settings/mockData.js), but uses the client's vocabulary for
// the table names rather than the mock's legacy keys:
//
//   mock `reseller` → Ggb            mock `company` → BusinessGroup
//   mock `group`    → Group          mock `companyId` → bgId
//
// The hierarchy:
//
//   Super Admin → Ggb → Group (optional) → BusinessGroup → Branch* → Vehicle
//
// Branch nests to any depth through parentBranchId. Every leaf entity (Branch,
// Vehicle, User, Alert) carries bgId directly rather than inheriting it from a
// parent, because the BG is the pivot every scope check filters on — see
// src/lib/scope.js. One read answers "which BG owns this row" without walking a
// chain, and a row whose parent went missing is still attributable.
//
// No telemetry lives here. Positions, speed, temperature and ignition all stay
// in Flespi; Vehicle.imei is the only identifier both sides carry and is
// therefore the join key.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Who a login account is, and therefore what it can see. Ordered widest to
/// narrowest. The scope links on User (ggbId / groupId / bgId) are what the
/// role is resolved against: see assertScopeLinks() in src/lib/users.js, which
/// enforces that exactly the right one is set for each role.
enum Role {
  SUPER_ADMIN
  GGB_ADMIN
  GROUP_ADMIN
  BG_USER
  SUB_USER
}

/// Spelled in the frontend's casing ('Active' / 'Inactive') so a row round-trips
/// to the Settings tables without a translation layer in between.
enum Status {
  Active
  Inactive
  /// Drivers only (2026-11-06): kept on file but taken off duty. The other
  /// tables' validators accept Active / Inactive alone.
  Suspended
}

/// Group Global Admin — the top of the tree below Super Admin. The mock calls
/// this a `reseller`.
model Ggb {
  id    String  @id @default(cuid())
  name  String
  /// Optional: the mock seeds two GGBs with no contact address at all.
  email String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups         Group[]
  businessGroups BusinessGroup[]
  users          User[]
}

/// An optional tier between a GGB and its BGs. A BG with no Group is its own
/// group — see BusinessGroup.groupId.
model Group {
  id    String @id @default(cuid())
  name  String
  ggbId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ggb            Ggb             @relation(fields: [ggbId], references: [id], onDelete: Cascade)
  businessGroups BusinessGroup[]
  users          User[]

  @@index([ggbId])
}

/// Business Group — the tenant boundary. Branches, vehicles, users and alerts
/// all belong to exactly one BG, and almost every scope check reduces to "which
/// BGs may this account see".
model BusinessGroup {
  id   String @id @default(cuid())
  name String

  /// Also the BG account's login username, which is why it is required here and
  /// globally unique rather than optional like Ggb.email.
  email String @unique

  ggbId String

  /// Nullable by design: null means this BG acts as its own group. The frontend
  /// renders that state as "— (own group)" rather than as missing data.
  groupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ggb      Ggb       @relation(fields: [ggbId], references: [id], onDelete: Cascade)
  group    Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  branches  Branch[]
  vehicles  Vehicle[]
  users     User[]
  alerts    Alert[]
  geofences Geofence[]
  drivers     Driver[]
  alertEvents AlertEvent[]
  expenses    Expense[]
  reminderRules ReminderRule[]
  reminderAcks  ReminderAck[]
  vehicleMoves  VehicleMove[]

  @@index([ggbId])
  @@index([groupId])
}

/// A branch, or a sub-branch of one, to unlimited depth.
///
/// `onDelete: Cascade` on the self-relation is what makes "deleting a branch
/// deletes its whole subtree" a database guarantee rather than an application
/// convention. The route still walks the subtree first — but only to count what
/// it is about to remove so the response can report it.
model Branch {
  id             String  @id @default(cuid())
  name           String
  bgId           String
  /// null for a top-level branch; otherwise another branch of the SAME bg,
  /// enforced in src/lib/branches.js along with cycle prevention.
  parentBranchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bg       BusinessGroup   @relation(fields: [bgId], references: [id], onDelete: Cascade)
  parent   Branch?         @relation("BranchTree", fields: [parentBranchId], references: [id], onDelete: Cascade)
  children Branch[]        @relation("BranchTree")
  vehicles Vehicle[]
  subusers SubuserBranch[]

  @@index([bgId])
  @@index([parentBranchId])
}

/// A tracked asset. Everything here is paperwork the operator maintains; the
/// live figures come from Flespi, keyed on `imei`.
model Vehicle {
  id   String  @id @default(cuid())
  bgId String
  /// Optional, and always a branch of the same bg. A branch delete sets this
  /// back to null (SetNull below) rather than taking the vehicle with it.
  branchId String?

  /// Free text. The client has not defined a Sub-Group entity; when they do this
  /// becomes a subGroupId pointing at its own table.
  subGroup String?

  /// Plate number — the mock's `vehicleNumber`.
  plateNo String?

  /// The operator's own identifier for the asset — the mock's `vehicleId`.
  /// Deliberately distinct from `imei`, which belongs to the tracking device.
  fleetNo String?

  /// The join key against a Flespi device's configuration.ident. Digits only,
  /// normalised on the way in, so a hand-typed space or dash cannot produce a
  /// second row that every human would call the same device.
  imei String @unique

  make        String?
  model       String?
  /// The tracking unit's own model, e.g. "Teltonika FMB920".
  deviceType  String?
  /// The SIM number in the tracking unit.
  mobileNo    String?
  vehicleType String?

  /**
   * Added in Phase 2, because the frontend's Vehicle form collects both and
   * without them a save silently discarded what the operator typed.
   *
   * `odometer` is free text, not a number: the form is a text input and the value
   * is paperwork the operator maintains by hand, not a measurement. It is NOT the
   * Live Map's ODO reading — that one comes from the tracker itself and is never
   * stored here.
   *
   * `groupId` is only meaningful when the vehicle's BG has no group of its own:
   * the form derives the group from the BG whenever the BG has one, and leaves it
   * selectable only in that case. Deliberately a plain id with no relation —
   * adding one would make a group delete cascade into vehicles, and a vehicle
   * must outlive an optional grouping tier.
   */
  odometer String?
  groupId  String?

  /// Validity — the date the vehicle's tracking service is valid until (client,
  /// 2026-11-06: "Validity against vehicle", filterable on the Live Map).
  /// Stored as UTC midnight of that day; the API speaks "YYYY-MM-DD".
  validUntil DateTime?

  /// Custom fields (client, 2026-11-09): whatever the client keeps against the
  /// vehicle — contract numbers, dates, contact names, e-mails, phones — as
  /// [{ name, value }] in the order they were entered. Saved on their own
  /// (PUT /api/vehicles/:id/custom-fields), never through the vehicle form.
  customFields          Json      @default("[]")
  customFieldsUpdatedAt DateTime?
  /// Who last changed them, as a name to show ("Super Admin", an e-mail).
  customFieldsUpdatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bg       BusinessGroup    @relation(fields: [bgId], references: [id], onDelete: Cascade)
  branch   Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  subusers SubuserVehicle[]
  alerts   AlertVehicle[]
  driver      Driver?
  alertEvents AlertEvent[]
  driverAssignments DriverAssignment[]
  driverIncidents   DriverIncident[]
  expenses          Expense[]
  reminders         ReminderVehicle[]
  reminderAcks      ReminderAck[]
  engineHours       VehicleEngineHours?
  moves             VehicleMove[]

  @@index([bgId])
  @@index([branchId])
}

/// A login account at any tier.
///
/// One table for all five roles rather than one per tier: every role needs the
/// same credential handling, the same token and the same change-password flow,
/// and the only thing that differs is which scope link is set.
model User {
  id String @id @default(cuid())

  /// Stored already lower-cased, and every lookup lower-cases its input, so the
  /// plain unique index below gives case-insensitive uniqueness without needing
  /// the citext extension on the deployment target. See normalizeEmail() in
  /// src/lib/text.js — it is the only place that decides what "same email"
  /// means.
  email        String @unique
  passwordHash String

  role   Role
  status Status @default(Active)

  /// True until the account changes the password it was handed. Set on every
  /// newly created BG user and sub-user, and on the seeded Super Admin.
  mustChangePassword Boolean @default(true)

  /// Display name. The mock keys the sub-user's as `name` so the shared
  /// SettingsTable can label row actions with it.
  shortName String?
  mobile    String?

  /// Profile photo, set from the mobile app or Account Settings. A random key,
  /// new on every upload: it is the photo's public URL (/api/avatars/<key>),
  /// unguessable and safe to cache forever. The bytes live in UserAvatar so
  /// ordinary user queries never carry an image.
  avatarKey String? @unique

  /// Exactly one of these is set, chosen by `role`: GGB_ADMIN → ggbId,
  /// GROUP_ADMIN → groupId, BG_USER and SUB_USER → bgId, SUPER_ADMIN → none.
  ggbId   String?
  groupId String?
  bgId    String?

  // ── Sub-user tab data ───────────────────────────────────────────────────
  // The six-tab sub-user form is ~40 preference controls and a permission
  // matrix over every screen. Columns for each would be a schema change every
  // time a screen is added, so each tab is stored as the JSON blob the frontend
  // already holds in state. Nothing server-side branches on their contents —
  // they are carried, validated for shape, and handed back.

  /// Tab 4 — the ~26 preference controls (time zone, formats, notification
  /// channels...). Shape: subuserSchema.js defaultUserSetting().
  userSetting Json?

  /// Tab 5 — { authRequiredFor: string[], deleteAuthFor: string[] }.
  authentication Json?

  /// Tab 6 — the SSO provider list.
  sso Json?

  /// Tab 3 — { [screenRoute]: 'none'|'view'|'modify'|'addDelete'|'customize' }.
  /// Sparse on purpose: an absent screen reads as the frontend's
  /// DEFAULT_PERMISSION, so adding a screen never has to migrate stored rows.
  screenAccess Json?

  /// Tabs 1-2 — share-via flags, security PIN, recovery email, selection mode.
  myAccount Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ggb Ggb?           @relation(fields: [ggbId], references: [id], onDelete: Cascade)
  grp Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  bg  BusinessGroup? @relation(fields: [bgId], references: [id], onDelete: Cascade)

  vehicles SubuserVehicle[]
  branches SubuserBranch[]
  flespiGrant FlespiGrant?
  avatar      UserAvatar?

  @@index([ggbId])
  @@index([groupId])
  @@index([bgId])
  @@index([role])
}

/// The Flespi ACL token currently issued to one account.
///
/// ── What is deliberately NOT here ───────────────────────────────────────────
///
/// The token KEY. Only Flespi's own id is stored, and the key is read back from
/// Flespi with the Master token whenever the client asks for it. A limited,
/// expiring, revocable third-party credential is still a credential, and keeping
/// it out of our database means a dump of this table grants nothing — it is a list
/// of integers. The cost is one extra Flespi call per refresh, and refreshes are
/// rare (once per login, then on expiry).
///
/// ── Why scopeHash ───────────────────────────────────────────────────────────
///
/// A cached token is only reusable while it still describes the right fleet. The
/// hash covers the ordered device-id list AND the methods, so reassigning a
/// sub-user's vehicles, adding a vehicle to their BG, or changing their role all
/// produce a different hash and force a new token on the next request. Comparing
/// the hash is what makes "reuse a valid cached token" safe rather than stale.
model FlespiGrant {
  /// One live grant per account: a second would be an orphan nobody revokes.
  userId String @id

  /// Flespi's token id, used to delete it and to read its key back.
  flespiTokenId Int

  /// Mirrors the Flespi token's own `expire`, which is set to the JWT's exp.
  expiresAt DateTime

  /// sha256 of the ACL this token was minted for. See the note above.
  scopeHash String

  /// How many devices the ACL covers, for logging and for the API response.
  deviceCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([flespiTokenId])
}

/// Which vehicles a sub-user may see. For a SUB_USER this join IS the scope —
/// nothing else grants a vehicle.
model SubuserVehicle {
  userId    String
  vehicleId String

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@id([userId, vehicleId])
  @@index([vehicleId])
}

/// Which branches a sub-user is filed under.
///
/// Stored and returned, but deliberately NOT a grant of the branch's vehicles
/// in this phase — see the scope table in src/lib/scope.js. Turning it into one
/// later is a change in that one file.
model SubuserBranch {
  userId   String
  branchId String

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
}

/// A rule watching some slice of one BG's fleet.
model Alert {
  id   String @id @default(cuid())
  name String

  /// Registry-driven on the frontend (ALERT_TYPES in mockData.js) and only
  /// 'temperature' exists today, so this is a string rather than an enum — a new
  /// type must not need a migration.
  type String @default("temperature")

  bgId String

  /// A mode, not a snapshot. Expanding "all" into a list of ids at write time
  /// would silently exclude every vehicle added afterwards. `vehicles` below is
  /// only read when this is false.
  allVehicles Boolean @default(true)

  /// Temperature bounds, in °C. Either may be null — one-sided rules ("over
  /// 45°C", no floor) are the common case.
  minTemp Float?
  maxTemp Float?

  /// { inApp, email, sms }. Carried for the UI; nothing dispatches on it yet.
  notify Json?

  status Status @default(Active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bg       BusinessGroup  @relation(fields: [bgId], references: [id], onDelete: Cascade)
  vehicles AlertVehicle[]

  /// Low | Medium | High | Critical — shown on every event this rule raises.
  severity String @default("Medium")

  /// The settings of `type` (lib/alertEngine.js TYPES), e.g. { speedKmh: 120 },
  /// { minutes: 15 }, { geofenceIds: [...] }, { from: "23:00", to: "05:00" },
  /// { days: 30 }. Temperature keeps its own minTemp / maxTemp columns.
  params Json?

  /// Who is emailed when the rule fires (when notify.email is on).
  emails String[] @default([])

  events AlertEvent[]
  states AlertState[]

  @@index([bgId])
}

/// Explicit vehicle scope for an alert whose allVehicles is false.
model AlertVehicle {
  alertId   String
  vehicleId String

  alert   Alert   @relation(fields: [alertId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@id([alertId, vehicleId])
  @@index([vehicleId])
}

/// A named map shape watching one BG's territory — the geofence report module's
/// foundation. Two conceptually distinct screens in the reference system
/// ("Address" and "Geofence") share this one table, discriminated by `kind`,
/// because they differ only in which fields are meaningful, not in shape:
/// a named polygon or circle, owned by one BG, optionally tagged with a
/// category. Splitting them into two tables would duplicate every column and
/// every scope rule for no behavioural gain.
enum GeofenceKind {
  /// A zone watched for entry/exit — the reference's own "Geofence" screen.
  /// Every sample in the reference's Geofence History report is a polygon.
  GEOFENCE
  /// A tagged point location watched for visits (arrival/departure/duration) —
  /// the reference's own "Address" screen, where every sample carries a
  /// category Type (Factory, Depot, ...).
  ADDRESS
}

enum GeofenceShape {
  POLYGON
  CIRCLE
}

model Geofence {
  id   String @id @default(cuid())
  bgId String

  kind  GeofenceKind
  shape GeofenceShape

  name String

  /// Polygon vertices in order, `[{ lat, lng }, ...]`. Null unless shape is
  /// POLYGON. A JSON column rather than a child table: the vertex count is
  /// small (validated at write time — see lib/geofences.js) and nothing ever
  /// queries into individual points, only reads the whole shape back.
  points Json?

  /// Circle center and radius in meters. Null unless shape is CIRCLE.
  centerLat Float?
  centerLng Float?
  radius    Float?

  /// Registry-driven on the frontend, same pattern as Alert.type — a string
  /// rather than an enum so a new category (the client's list is already
  /// described as "editable/extendable") is a frontend change, not a
  /// migration. Most meaningful for kind ADDRESS (Factory, Depot, Warehouse,
  /// Customer, Other, ...) but not restricted to it.
  category String?

  color       String?
  description String?
  active      Boolean @default(true)

  /// Speed limit inside the zone (client, 2026-11-09), for the "Geo Zone
  /// Speed Violation" alert. Null: no limit here.
  speedLimitKmh Int?
  /// How long the vehicle may stay over that limit before it is a violation.
  /// Shorter excursions are only recorded; 0 alerts at once.
  speedGraceSec Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bg BusinessGroup @relation(fields: [bgId], references: [id], onDelete: Cascade)

  /// One name per BG, not global — two different BGs both naming a yard
  /// "Main Gate" is not a collision the way two BGs sharing a login email
  /// would be.
  @@unique([bgId, name])
  @@index([bgId])
}

/// Reverse-geocode results, shared by every user and every browser — the
/// Movement Report's Location column and the Geo Zone reports' addresses.
///
/// Before this table the cache lived only in each browser's localStorage, so a
/// client opening a report on a new machine waited out Nominatim's 1 request per
/// second for every one of a fleet-day's ~2,000 points again. A street does not
/// move, so an entry never goes stale; vehicles repeat their routes, so the hit
/// rate climbs every day the fleet runs.
model GeocodeCache {
  /// "lat,lng" rounded to 4 decimal places (~11 m) — the same key the
  /// frontend's geocode.js geocodeKey() builds, so the two caches agree.
  key       String   @id
  /// Null = the geocoder answered with no address (open desert, sea). Cached
  /// too, so the point is not asked again; a failed REQUEST is never stored.
  address   String?
  createdAt DateTime @default(now())
}

/// One Flespi device's distance and engine-on time for one UAE day, computed by
/// src/lib/dailyUsage.js so the Daywise reports read a month in one query
/// instead of fetching ~30 days of raw messages per click.
///
/// A derived summary, not telemetry: the positions themselves stay in Flespi
/// (see the header), and every row can be rebuilt from there. Keyed by Flespi
/// device id rather than Vehicle, because a device that is not registered in
/// Settings yet is still on a Super Admin's report, and report scoping already
/// works in device ids (lib/flespiGrant.js buildAcl).
model DailyUsage {
  deviceId    Int
  /// UAE calendar date, "YYYY-MM-DD".
  day         String  @db.VarChar(10)
  distanceKm  Float
  ignitionSec Int
  /// The device hit Flespi's per-request message cap that day, so it may be short.
  capped      Boolean @default(false)

  @@id([deviceId, day])
  @@index([day])
}

/// Which UAE days dailyUsage.js has computed. A day absent here has no figures
/// yet; a final one ended over 48 h ago, so late uploads are in and it is never
/// computed again.
model UsageDay {
  day        String   @id @db.VarChar(10)
  final      Boolean  @default(false)
  computedAt DateTime @default(now())
}

/// One time an alert rule fired: the history behind Notifications and the bell.
///
/// Written by lib/alertEngine.js, which evaluates every active rule on the
/// server every ~30 s, so an alert is raised whether or not anyone has the app
/// open, and every user of the BG sees the same history.
model AlertEvent {
  id        String  @id @default(cuid())
  /// Null once the rule is deleted; the history stays.
  alertId   String?
  bgId      String
  vehicleId String?
  deviceId  Int?
  driverId  String?

  type     String
  severity String
  title    String
  message  String
  /// The measured value that tripped the rule (km/h, minutes, °C, days).
  value    Float?
  lat      Float?
  lng      Float?

  occurredAt DateTime  @default(now())
  /// Shared, not per user: "read" means someone in the BG has seen it.
  readAt     DateTime?
  /// Set once the notification email went out; null when none was due or SMTP is off.
  emailedAt  DateTime?

  alert   Alert?        @relation(fields: [alertId], references: [id], onDelete: SetNull)
  bg      BusinessGroup @relation(fields: [bgId], references: [id], onDelete: Cascade)
  vehicle Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver  Driver?       @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([bgId, occurredAt])
  @@index([alertId, occurredAt])
}

/// What the alert engine remembers per rule and subject (a device, or a driver
/// for licence expiry) between passes — "was inside geofence X", "idle since",
/// "last fired at" — so an alert fires on the change, not on every pass, and a
/// restart does not fire everything again.
model AlertState {
  alertId   String
  /// "d:<flespi device id>" or "drv:<driver id>".
  subject   String
  state     Json
  updatedAt DateTime @updatedAt

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@id([alertId, subject])
}

/// A driver of one BG, optionally assigned to one of its vehicles.
///
/// One vehicle has at most one assigned driver (vehicleId is unique), which is
/// what lets the Live Map and the reports print "the driver of this vehicle".
model Driver {
  id   String @id @default(cuid())
  bgId String

  /// Shown as DRV-0001: a running number, never reused.
  driverNo      Int       @unique @default(autoincrement())
  name          String
  mobile        String?
  email         String?
  nationality   String?
  dateOfBirth   DateTime?
  employeeId    String?
  department    String?
  joiningDate   DateTime?
  /// Random key of the profile photo (GET /api/driver-photos/:key), replaced on every upload.
  photoKey      String?   @unique
  licenseNo     String?
  licenseCategory  String?
  licenseIssueDate DateTime?
  licenseCountry   String?
  /// Further expiries the Driver Licence & Document Expiry alert watches.
  visaExpiry       DateTime?
  emiratesId       String?
  emiratesIdExpiry DateTime?
  medicalExpiry    DateTime?
  /// Date only (stored at UTC midnight); drives the Driver Licence Expiry alert.
  licenseExpiry DateTime?
  /// The driver's iButton / driver-ID tag as the tracker reports it in
  /// `ibutton.code` (upper-case hex). Unique: one physical tag, one driver. A
  /// trip driven with this tag shows this driver, whichever vehicle it was.
  ibuttonCode   String?   @unique
  vehicleId     String?   @unique
  notes         String?
  status        Status    @default(Active)

  // The rest of the reference system's driver form (client, 2026-11-09).
  contactNumber2 String?
  country        String?
  state          String?
  city           String?
  zipCode        String?
  street1        String?
  street2        String?
  /// How the driver is identified on the tracker ("Tag Via"): iButton, RFID or Beacon.
  tagType        String?
  leavingDate    DateTime?
  retirementDate DateTime?
  /// Driving since: the form shows the years of experience from it.
  drivingSince   DateTime?
  licenseAvailable    Boolean   @default(true)
  lifeInsuranceNo     String?
  lifeInsuranceExpiry DateTime?
  mediclaimNo         String?
  mediclaimExpiry     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bg        BusinessGroup @relation(fields: [bgId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  events    AlertEvent[]
  photo       DriverPhoto?
  documents   DriverDocument[]
  assignments DriverAssignment[]
  incidents   DriverIncident[]
  leaves      DriverLeave[]

  @@index([bgId])
}

/// Who drove which vehicle when (Driver Management phase 2). The Primary row
/// mirrors Driver.vehicleId and is opened / closed when that changes;
/// Temporary rows are dated cover. A trip with no iButton tag is credited to
/// the Temporary row covering its start, else the Primary one.
model DriverAssignment {
  id        String    @id @default(cuid())
  driverId  String
  vehicleId String
  role      String
  startDate DateTime
  endDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([vehicleId])
}

/// An accident or incident on a driver's record (entered by hand).
/// Leave on a driver's record (Settings › Driver › Leave).
model DriverLeave {
  id        String    @id @default(cuid())
  driverId  String
  leaveType String
  /// Days of leave; the form fills it from the dates, but it may differ (working days).
  days      Int?
  validFrom DateTime
  validTo   DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
}

model DriverIncident {
  id          String   @id @default(cuid())
  driverId    String
  vehicleId   String?
  date        DateTime
  type        String
  description String?
  cost        Float?
  createdAt   DateTime @default(now())

  driver  Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([driverId])
}

/// Account-wide settings by key, e.g. "fatigue" (the driving-time rule).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// A driver's profile photo bytes; one row per driver, replaced on upload.
model DriverPhoto {
  driverId  String   @id
  key       String   @unique
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

/// A scanned copy of a driver's licence, visa, Emirates ID, medical or other paper.
model DriverDocument {
  id         String    @id @default(cuid())
  driverId   String
  title      String
  docType    String
  issueDate  DateTime?
  expiryDate DateTime?
  fileName   String
  mimeType   String
  size       Int
  data       Bytes
  createdAt  DateTime  @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
}

/// The bytes of a user's profile photo (see User.avatarKey). One row per user,
/// replaced on upload; at most a few hundred KB, already resized by the client.
model UserAvatar {
  userId    String   @id
  key       String   @unique
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Telemetry kept by FleetmaxX (2026-11-02) ────────────────────────────────
// Flespi pushes every message to POST /api/ingest/flespi (an HTTP Stream);
// lib/telemetry.js keeps the latest state per device and 90 days of history,
// so the website, the app, the alert engine and the reports read our database
// instead of calling Flespi again and again (built to carry 5,000+ vehicles).

/// The latest message of each Flespi device — what the live map shows.
model DeviceState {
  deviceId    Int      @id
  ident       String?
  /// Unix seconds of the message these values came from.
  ts          Int
  lat         Float?
  lng         Float?
  speed       Float?
  heading     Float?
  ignition    Boolean?
  /// vehicle.mileage, km.
  odometerKm  Float?
  satellites  Int?
  valid       Boolean?
  fuel        Float?
  temperature Float?
  /// Less common fields the code reads, only when the device sends them.
  extra       Json?
  updatedAt   DateTime @updatedAt

  @@index([ts])
}

/// Every message, kept TELEMETRY_RETENTION_DAYS. The table is PARTITIONED BY
/// RANGE (ts), one partition per UTC day, created ahead and dropped behind by
/// lib/telemetry.js — so expiring a day is a DROP, not a slow DELETE. Written
/// with raw SQL in batches; read by deviceId and time range.
model TelemetryMessage {
  deviceId    Int
  ts          Int
  lat         Float?
  lng         Float?
  speed       Float?
  heading     Float?
  ignition    Boolean?
  odometerKm  Float?
  satellites  Int?
  valid       Boolean?
  fuel        Float?
  temperature Float?
  extra       Json?

  @@id([deviceId, ts])
}

/// A public link to one vehicle's replay (client, 2026-11-09): anyone with the
/// link sees where the vehicle went in [fromTs, toTs], without signing in, until
/// expiresAt. The track is copied in when the link is made, so opening it costs
/// no Flespi request and shows exactly what was shared.
model ReplayShare {
  id          String    @id @default(cuid())
  /// The secret in the link: 32 random URL-safe characters.
  token       String    @unique
  deviceId    Int
  vehicleName String
  fromTs      Int
  toTs        Int
  expiresAt   DateTime
  /// [[ts, lat, lng, speed, heading, ignition], …] in time order.
  points      Json
  pointCount  Int
  truncated   Boolean   @default(false)
  /// Who made it. A plain id: a link outlives nothing but its own expiry.
  createdById String
  createdAt   DateTime  @default(now())
  /// Set when the link is switched off before it expires.
  revokedAt   DateTime?

  @@index([createdById])
}

/// What a vehicle costs (Settings › Master › Expense, client 2026-11-09).
/// Variable: one cost on one day (expenseDate, odometer, work time).
/// Fix: a cost over a period (fromDate to toDate).
model Expense {
  id        String  @id @default(cuid())
  bgId      String
  /// Null once the vehicle is deleted; vehicleLabel keeps its plate.
  vehicleId    String?
  vehicleLabel String

  category    String
  type        String
  subType     String?
  expenseDate DateTime?
  fromDate    DateTime?
  toDate      DateTime?
  odometer    Float?
  workMinutes Int?
  fuelSource  String?
  vendor      String?
  amount      Float
  referenceNo String?
  description String?

  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bg      BusinessGroup @relation(fields: [bgId], references: [id], onDelete: Cascade)
  vehicle Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  bills   ExpenseBill[]

  @@index([bgId])
  @@index([vehicleId])
}

/// A bill or receipt for an expense (up to three), PDF or image.
model ExpenseBill {
  id        String   @id @default(cuid())
  expenseId String
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

/// A maintenance or renewal reminder (Settings › Master › Reminder Rule, client
/// 2026-11-10, after the reference system). Recurring or One Time, counted by
/// duration, distance and/or engine hours, whichever comes first, for each of
/// its vehicles from that vehicle's own start point (ReminderVehicle).
model ReminderRule {
  id        String  @id @default(cuid())
  bgId      String
  name      String
  /// "Oil Change", "Insurance"… (the reference's grouped list, or own text).
  type      String
  recurring Boolean @default(true)

  byDuration    Boolean @default(true)
  byDistance    Boolean @default(false)
  byEngineHours Boolean @default(false)
  /// Recurring: Daily | Weekly | Monthly, every `every` of those. One Time: at `every` months.
  frequency  String  @default("Monthly")
  every      Int?
  notifyDays Int?
  everyKm    Float?
  notifyKm   Float?
  everyHours  Float?
  notifyHours Float?

  notifyInApp Boolean  @default(true)
  notifyEmail Boolean  @default(false)
  emails      String[] @default([])
  active      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bg       BusinessGroup     @relation(fields: [bgId], references: [id], onDelete: Cascade)
  vehicles ReminderVehicle[]
  acks     ReminderAck[]

  @@index([bgId])
}

/// One vehicle on a reminder rule: where its count starts, and its state.
model ReminderVehicle {
  id        String @id @default(cuid())
  ruleId    String
  vehicleId String

  /// The cycle starts here (the reference's "Reminder Start Date"); Mark done moves it.
  startDate   DateTime
  /// Distance and engine hours already run in this cycle before the start date.
  kmBefore    Float @default(0)
  hoursBefore Float @default(0)
  /// Odometer and counted engine hours when the cycle started (filled by the server).
  startOdometer    Float?
  startEngineHours Float?
  /// A renewal's own dates; the expiry stands for the duration when set.
  issueDate  DateTime?
  expiryDate DateTime?

  /// The last step notified in this cycle (due | overdue), so each is sent once.
  alerted     String?
  /// A One Time reminder that was done.
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  rule    ReminderRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  vehicle Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, vehicleId])
  @@index([vehicleId])
}

/// "Mark done" (the reference's Acknowledgement History). Kept when the rule or vehicle goes.
model ReminderAck {
  id           String   @id @default(cuid())
  bgId         String
  ruleId       String?
  ruleName     String
  type         String
  vehicleId    String?
  vehicleLabel String
  doneAt       DateTime
  odometer     Float?
  engineHours  Float?
  note         String?
  expenseId    String?
  byName       String?
  createdAt    DateTime @default(now())

  bg      BusinessGroup @relation(fields: [bgId], references: [id], onDelete: Cascade)
  rule    ReminderRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  vehicle Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([bgId])
  @@index([vehicleId])
}

/// Engine hours the server counts from ignition-on time (the trackers send no hour meter).
model VehicleEngineHours {
  vehicleId    String   @id
  hours        Float    @default(0)
  lastTs       Int?
  lastIgnition Boolean?
  updatedAt    DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

/// Reallocation History (client report list, 2026-11-10): each time a vehicle
/// changed branch, group or Group Global Admin. Names are kept as they read at
/// the time, so the history survives a rename or a delete; `bgId` is the
/// vehicle's BG, which is what scopes who may read it.
model VehicleMove {
  id           String  @id @default(cuid())
  bgId         String
  /// Null once the vehicle is deleted; vehicleLabel and imei keep what it was.
  vehicleId    String?
  vehicleLabel String
  imei         String?

  /// What changed: 'branch', 'group' or 'ggb'.
  level    String
  fromName String?
  toName   String?

  movedById   String?
  movedByName String?
  movedAt     DateTime @default(now())

  bg      BusinessGroup @relation(fields: [bgId], references: [id], onDelete: Cascade)
  vehicle Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([bgId, movedAt])
  @@index([vehicleId])
}
