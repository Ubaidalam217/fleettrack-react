# FleetmaX tracking backend — environment template.
#
# Copy to server/.env and fill in real values. server/.env is gitignored and must
# stay that way: everything below is a credential or a secret.
#
#   cp server/.env.example server/.env
#
# Every value here is read exactly once, in src/env.js, which validates them on
# boot. A missing or malformed value is a startup crash with the field named —
# not a surprise at request time.

# development | test | production
NODE_ENV=development
PORT=4000

# ── Database ────────────────────────────────────────────────────────────────
# Local Postgres 16. The application connects as a dedicated, non-superuser role;
# the postgres superuser password is only ever needed to create the role and the
# databases once, and is deliberately not recorded in this project.
DATABASE_URL="postgresql://fleetmax:REPLACE_WITH_ROLE_PASSWORD@localhost:5432/fleetmax_tracking?schema=public"

# Read only when NODE_ENV=test. A separate database because the suite truncates
# every table it touches — pointing this at the development database would empty
# it. Required for `npm test`.
TEST_DATABASE_URL="postgresql://fleetmax:REPLACE_WITH_ROLE_PASSWORD@localhost:5432/fleetmax_tracking_test?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────────
# At least 32 characters, and different on every deployment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN=12h

# bcrypt cost. 12 is the production figure; the test suite overrides it to 4.
BCRYPT_ROUNDS=12

# Handed to every newly created BG user and sub-user, together with
# mustChangePassword = true.
DEFAULT_USER_PASSWORD="Aa@123456"

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated exact origins — scheme, host and port, no trailing slash.
# Empty means no browser origin is allowed, which is the correct default for a
# fresh deployment; curl and server-to-server callers are unaffected.
FRONTEND_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ── Login rate limit ────────────────────────────────────────────────────────
# Keyed on IP + submitted email, so one person mistyping their own password
# cannot lock out everyone behind the same office NAT.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# ── Seed ────────────────────────────────────────────────────────────────────
# The single Super Admin created by `npm run seed`. The seed sets
# mustChangePassword = true, so this password is only ever used once.
SEED_SUPERADMIN_EMAIL="admin@example.com"
SEED_SUPERADMIN_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD"
